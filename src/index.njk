</section>

<section class="section insights-preview">
  <div class="section-heading">
    <p class="eyebrow">Latest Insights</p>
    <h2>Engineer-to-engineer content for validators and infrastructure teams.</h2>
  </div>
  <div class="post-grid">
    {% for post in collections.posts %}
    {% if loop.index <= 3 %}
    <a class="post-card" href="{{ post.url }}">
      <span>{{ post.data.category }}</span>
      <h3>{{ post.data.title }}</h3>
      <p>{{ post.data.summary }}</p>
      <small>{{ post.data.date | readableDate }}</small>
    </a>
    {% endif %}
    {% endfor %}
  </div>
</section>

<section id="consultation" class="consultation">
  <div>
    <p class="eyebrow">Book a Node Audit</p>
    <h2>Find out whether your node workload should move to bare metal.</h2>
    <p>Send your chain, region, uptime target, current monthly cost, and whether you need single-node Pro or Enterprise failover. GSVIEC will respond with the next technical step.</p>
  </div>
  <form class="contact-form" action="{{ site.formEndpoint }}" method="POST" data-contact-form>
    <label>Full name<input name="name" autocomplete="name" required></label>
    <label>Work email<input type="email" name="email" autocomplete="email" required></label>
    <label>Project / company<input name="company" autocomplete="organization"></label>
    <label>Node or infrastructure need<textarea name="message" rows="5" placeholder="Network, current provider, monthly cost, uptime target, region, and expected node count" required></textarea></label>
    <button class="button primary" type="submit">Request infrastructure audit</button>
    <p class="form-note">Replace the Formspree endpoint in <code>src/_data/site.json</code> before production.</p>
  </form>
</section>
