<!doctype html>
<html lang="{{ lang or 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title or site.defaultTitle }}</title>
    <meta name="description" content="{{ description or site.defaultDescription }}">
    <link rel="canonical" href="{{ site.domain }}{{ page.url }}">
    <meta name="robots" content="index, follow, max-image-preview:large">
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:title" content="{{ title or site.defaultTitle }}">
    <meta property="og:description" content="{{ description or site.defaultDescription }}">
    <meta property="og:url" content="{{ site.domain }}{{ page.url }}">
    <meta property="og:image" content="{{ site.domain }}{{ socialImage or site.socialImage }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title or site.defaultTitle }}">
    <meta name="twitter:description" content="{{ description or site.defaultDescription }}">
    <meta name="theme-color" content="#0B192C">
    <link rel="icon" href="{{ '/assets/favicon-gsviec.png' | relativeUrl(page.url) }}" type="image/png">
    <link rel="manifest" href="{{ '/assets/site.webmanifest' | relativeUrl(page.url) }}">
    <link rel="stylesheet" href="{{ '/assets/css/style.css' | relativeUrl(page.url) }}">
    {% if schema %}
    <script type="application/ld+json">{{ schema | safe }}</script>
    {% endif %}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-header>
      <a class="brand" href="{{ '/' | relativeUrl(page.url) }}" aria-label="GSVIEC home">
        <img src="{{ '/assets/logo-gsviec.png' | relativeUrl(page.url) }}" alt="" width="44" height="44">
        <span><strong>GSVIEC</strong><small data-i18n="brand.subtitle">Enterprise Computing</small></span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
        <span></span><span></span><span></span>
      </button>
      <nav id="site-nav" class="site-nav" data-nav>
        <a href="{{ '/#problem' | relativeUrl(page.url) }}" data-i18n="nav.problem">Problem</a>
        <a href="{{ '/#plans' | relativeUrl(page.url) }}" data-i18n="nav.plans">Plans</a>
        <a href="{{ '/#architecture' | relativeUrl(page.url) }}" data-i18n="nav.architecture">Architecture</a>
        <a href="{{ '/#comparison' | relativeUrl(page.url) }}" data-i18n="nav.compare">Compare</a>
        <a href="{{ '/insights/' | relativeUrl(page.url) }}" data-i18n="nav.insights">Insights</a>
        <div class="language-toggle" aria-label="Language switcher">
          <button type="button" data-lang-toggle="en" aria-pressed="true">EN</button>
          <button type="button" data-lang-toggle="vi" aria-pressed="false">VI</button>
        </div>
        <a class="nav-cta" href="{{ '/#consultation' | relativeUrl(page.url) }}" data-i18n="nav.cta">Book a node audit</a>
      </nav>
    </header>
    <main id="main">
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <div>
        <div class="footer-brand">
          <img src="{{ '/assets/logo-gsviec.png' | relativeUrl(page.url) }}" alt="" width="46" height="46">
          <strong>GSVIEC</strong>
        </div>
        <p data-i18n="footer.description">Global Solutions for Virtualized Infrastructure & Enterprise Computing. Bare-metal automation and Web3 node infrastructure for teams that need control, performance, and uptime.</p>
      </div>
      <div>
        <strong data-i18n="footer.contact">Contact</strong>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        <span>{{ site.address }}</span>
      </div>
      <div>
        <strong data-i18n="footer.navigate">Navigate</strong>
        <a href="{{ '/services/bare-metal-node-hosting/' | relativeUrl(page.url) }}" data-i18n="service.bare-metal-node-hosting.title">Bare-metal Node Hosting</a>
        <a href="{{ '/services/validator-infrastructure/' | relativeUrl(page.url) }}" data-i18n="service.validator-infrastructure.title">Validator Infrastructure</a>
        <a href="{{ '/insights/' | relativeUrl(page.url) }}" data-i18n="nav.insights">Insights</a>
      </div>
    </footer>
    <div id="deploy-console" aria-live="polite" aria-label="Deploy mode console">
      <button type="button" class="deploy-close" data-deploy-close aria-label="Close deploy console">×</button>
      <div class="deploy-console-inner">
        <p class="deploy-title">GSVIEC DEPLOY MODE</p>
        <div data-deploy-log></div>
      </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" defer></script>
    <script src="https://unpkg.com/lucide@latest" defer></script>
    <script src="{{ '/assets/js/main.js' | relativeUrl(page.url) }}" defer></script>
  </body>
</html>
