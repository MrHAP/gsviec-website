<!doctype html>
<html lang="{{ lang or 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title or site.defaultTitle }}</title>
    <meta name="description" content="{{ description or site.defaultDescription }}">
    <link rel="canonical" href="{{ site.domain }}{{ page.url }}">
    <meta name="robots" content="index, follow, max-image-preview:large">
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:title" content="{{ title or site.defaultTitle }}">
    <meta property="og:description" content="{{ description or site.defaultDescription }}">
    <meta property="og:url" content="{{ site.domain }}{{ page.url }}">
    <meta property="og:image" content="{{ site.domain }}{{ socialImage or site.socialImage }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title or site.defaultTitle }}">
    <meta name="twitter:description" content="{{ description or site.defaultDescription }}">
    <meta name="theme-color" content="#0B192C">
    <link rel="icon" href="/assets/favicon-gsviec.png" type="image/png">
    <link rel="manifest" href="/assets/site.webmanifest">
    <link rel="stylesheet" href="/assets/css/style.css">
    {% if schema %}
    <script type="application/ld+json">{{ schema | safe }}</script>
    {% endif %}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-header>
      <a class="brand" href="/" aria-label="GSVIEC home">
        <img src="/assets/logo-gsviec.png" alt="" width="44" height="44">
        <span><strong>GSVIEC</strong><small>Enterprise Computing</small></span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
        <span></span><span></span><span></span>
      </button>
      <nav id="site-nav" class="site-nav" data-nav>
        <a href="/#problem">Problem</a>
        <a href="/#plans">Plans</a>
        <a href="/#architecture">Architecture</a>
        <a href="/#comparison">Compare</a>
        <a href="/insights/">Insights</a>
        <a class="nav-cta" href="/#consultation">Book a node audit</a>
      </nav>
    </header>
    <main id="main">
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <div>
        <div class="footer-brand">
          <img src="/assets/logo-gsviec.png" alt="" width="46" height="46">
          <strong>GSVIEC</strong>
        </div>
        <p>Global Solutions for Virtualized Infrastructure & Enterprise Computing. Bare-metal automation and Web3 node infrastructure for teams that need control, performance, and uptime.</p>
      </div>
      <div>
        <strong>Contact</strong>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        <span>{{ site.address }}</span>
      </div>
      <div>
        <strong>Navigate</strong>
        <a href="/services/bare-metal-node-hosting/">Bare-metal Node Hosting</a>
        <a href="/services/validator-infrastructure/">Validator Infrastructure</a>
        <a href="/insights/">Insights</a>
      </div>
    </footer>
    <script src="/assets/js/main.js" defer></script>
  </body>
</html>
